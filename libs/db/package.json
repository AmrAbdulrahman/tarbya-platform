{
  "name": "@tarbya/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "db",
    "tags": [
      "scope:api"
    ],
    "targets": {
      "prisma-generate": {
        "command": "prisma generate",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "{projectRoot}/prisma/schema.prisma"
        ],
        "outputs": [
          "{projectRoot}/src/generated/prisma"
        ]
      },
      "migrate-dev": {
        "command": "prisma migrate dev",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "migrate-deploy": {
        "command": "prisma migrate deploy",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "seed": {
        "command": "prisma db seed",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "studio": {
        "command": "prisma studio",
        "options": {
          "cwd": "{projectRoot}"
        },
        "continuous": true
      },
      "typecheck": {
        "dependsOn": [
          "prisma-generate"
        ]
      },
      "lint": {
        "dependsOn": [
          "prisma-generate"
        ]
      },
      "build": {
        "dependsOn": [
          "prisma-generate"
        ]
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tarbya/shared": "workspace:*",
    "pg": "^8.23.1"
  }
}
