// Baseline schema. Domain models are added module by module, following
// docs/architecture.md ("Data model").

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // The api bundle is CommonJS.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  ar
  en
}

enum CalendarPreference {
  GREGORIAN
  HIJRI
  BOTH
}

model User {
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  email         String?            @unique
  phone         String?            @unique
  locale        Locale             @default(ar)
  calendar      CalendarPreference @default(GREGORIAN)
  isModerator   Boolean            @default(false)
  managerId     String?            @db.Uuid
  manager       User?              @relation("Management", fields: [managerId], references: [id])
  reports       User[]             @relation("Management")
  deactivatedAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([managerId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
