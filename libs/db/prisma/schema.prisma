// Baseline schema. Domain models are added module by module, following
// docs/architecture.md ("Data model").

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // The api bundle is CommonJS.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  ar
  en
}

enum CalendarPreference {
  GREGORIAN
  HIJRI
  BOTH
}

model User {
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  email         String?            @unique
  phone         String?            @unique
  locale        Locale             @default(ar)
  calendar      CalendarPreference @default(BOTH)
  isModerator   Boolean            @default(false)
  managerId     String?            @db.Uuid
  manager       User?              @relation("Management", fields: [managerId], references: [id])
  reports       User[]             @relation("Management")
  deactivatedAt DateTime?
  avatarFileId  String?            @unique @db.Uuid
  avatarFile    FileObject?        @relation(fields: [avatarFileId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  password                  PasswordCredential?
  sessions                  Session[]                @relation("SessionOwner")
  impersonatedIn            Session[]                @relation("SessionImpersonated")
  mentoring                 Mentorship[]             @relation("Mentor")
  mentoredBy                Mentorship[]             @relation("Mentee")
  audited                   AuditLog[]               @relation("AuditActor")
  created                   Interaction[]            @relation("InteractionCreator")
  joined                    InteractionParticipant[]
  tasks                     Task[]                   @relation("TaskAssignee")
  tasksSet                  Task[]                   @relation("TaskCreator")
  notes                     Note[]                   @relation("NoteAuthor")
  adminNotes                AdminNote[]              @relation("AdminNoteSubject")
  adminNotesWritten         AdminNote[]              @relation("AdminNoteAuthor")
  contactChanges            ContactChange[]
  trackables                Trackable[]              @relation("TrackableMentee")
  trackablesCreated         Trackable[]              @relation("TrackableCreator")
  entries                   TrackableEntry[]         @relation("EntryAuthor")
  replies                   TrackableReply[]         @relation("ReplyAuthor")
  challenges                Challenge[]              @relation("ChallengeMentee")
  challengesRaised          Challenge[]              @relation("ChallengeCreator")
  challengesResolved        Challenge[]              @relation("ChallengeResolver")
  challengeComments         ChallengeComment[]       @relation("ChallengeCommentAuthor")
  createdInImpersonation    Interaction[]            @relation("InteractionImpersonator")
  tasksSetInImpersonation   Task[]                   @relation("TaskImpersonator")
  notesInImpersonation      Note[]                   @relation("NoteImpersonator")
  adminNotesInImpersonation AdminNote[]              @relation("AdminNoteImpersonator")
  trackablesInImpersonation Trackable[]              @relation("TrackableImpersonator")
  trackableTemplates        TrackableTemplate[]      @relation("TemplateAuthor")
  templatesInImpersonation  TrackableTemplate[]      @relation("TemplateImpersonator")
  entriesInImpersonation    TrackableEntry[]         @relation("EntryImpersonator")
  repliesInImpersonation    TrackableReply[]         @relation("ReplyImpersonator")
  challengesInImpersonation Challenge[]              @relation("ChallengeImpersonator")
  commentsInImpersonation   ChallengeComment[]       @relation("ChallengeCommentImpersonator")
  auditedOnBehalf           AuditLog[]               @relation("AuditOnBehalfOf")

  @@index([managerId])
}

// ── Auth (US-1.1 … US-1.3) ────────────────────────────────────────────────

model PasswordCredential {
  userId    String   @id @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  hash      String
  updatedAt DateTime @updatedAt
}

enum OneTimeCodePurpose {
  SIGN_IN
}

/// Emailed codes. Stored as an HMAC, never in clear.
model OneTimeCode {
  id        String             @id @default(uuid()) @db.Uuid
  email     String
  purpose   OneTimeCodePurpose
  codeHash  String
  attempts  Int                @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime           @default(now())

  @@index([email, purpose, createdAt])
}

/// One row per sign-in. The refresh token is "<id>.<secret>"; only the current
/// secret's hash is kept, plus the previous one for a short grace window.
model Session {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  user               User      @relation("SessionOwner", fields: [userId], references: [id])
  /// The super admin is viewing the app as this user; tokens carry them as `sub` and the owner as `act`.
  impersonatedUserId String?   @db.Uuid
  impersonatedUser   User?     @relation("SessionImpersonated", fields: [impersonatedUserId], references: [id])
  tokenHash          String
  previousHash       String?
  rotatedAt          DateTime?
  expiresAt          DateTime
  revokedAt          DateTime?
  userAgent          String?
  ip                 String?
  createdAt          DateTime  @default(now())
  lastUsedAt         DateTime  @default(now())

  @@index([userId])
}

// ── Mentoring (US-3.3, BR-MEN-1…4) ───────────────────────────────────────
// Ending a mentorship sets endedAt; its follow-ups and notes stay attached.

model Mentorship {
  id        String    @id @default(uuid()) @db.Uuid
  mentorId  String    @db.Uuid
  mentor    User      @relation("Mentor", fields: [mentorId], references: [id])
  menteeId  String    @db.Uuid
  mentee    User      @relation("Mentee", fields: [menteeId], references: [id])
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  followUps Interaction[]
  notes     Note[]

  @@index([mentorId])
  @@index([menteeId])
}

// ── Follow-ups and activities (US-4.3, US-4.4, BR-FU-1…5) ─────────────────
// Upcoming or done is derived from startsAt; nobody stores it (BR-FU-3).

enum InteractionKind {
  FOLLOW_UP
  ACTIVITY
}

model Interaction {
  id             String          @id @default(uuid()) @db.Uuid
  kind           InteractionKind
  /// Follow-ups only: the mentorship they belong to.
  mentorshipId   String?         @db.Uuid
  mentorship     Mentorship?     @relation(fields: [mentorshipId], references: [id])
  /// Activities only.
  activityTypeId String?         @db.Uuid
  activityType   ActivityType?   @relation(fields: [activityTypeId], references: [id])
  createdById    String          @db.Uuid
  createdBy      User            @relation("InteractionCreator", fields: [createdById], references: [id])
  /// The super admin who wrote this while impersonating the author (BR-ADM-5).
  impersonatorId String?         @db.Uuid
  impersonator   User?           @relation("InteractionImpersonator", fields: [impersonatorId], references: [id])
  title          String?
  startsAt       DateTime
  /// Multi-day activities (a trip): the return date.
  endsAt         DateTime?
  place          String?
  /// Seen by participants, the creator and moderators.
  sharedNotes    String?
  /// The creator and moderators only; dropped in the query for anyone else (BR-NOTE-1).
  privateNotes   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  participants InteractionParticipant[]
  tasks        Task[]
  entries      TrackableEntry[]
  challenges   Challenge[]
  comments     ChallengeComment[]

  @@index([mentorshipId, startsAt])
  @@index([createdById, startsAt])
}

model InteractionParticipant {
  interactionId String      @db.Uuid
  interaction   Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  userId        String      @db.Uuid
  user          User        @relation(fields: [userId], references: [id])

  @@id([interactionId, userId])
  @@index([userId])
}

/// One-time tasks (BR-FU-4): the mentee ticks them off.
model Task {
  id             String       @id @default(uuid()) @db.Uuid
  assigneeId     String       @db.Uuid
  assignee       User         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById    String       @db.Uuid
  createdBy      User         @relation("TaskCreator", fields: [createdById], references: [id])
  /// The super admin who wrote this while impersonating the author (BR-ADM-5).
  impersonatorId String?      @db.Uuid
  impersonator   User?        @relation("TaskImpersonator", fields: [impersonatorId], references: [id])
  interactionId  String?      @db.Uuid
  interaction    Interaction? @relation(fields: [interactionId], references: [id])
  title          String
  /// A calendar day in the organisation's time zone.
  dueOn          DateTime?    @db.Date
  doneAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([assigneeId, doneAt])
}

// ── Notes (US-4.6, BR-NOTE-1) ─────────────────────────────────────────────

enum NoteVisibility {
  /// The mentee, the mentor and moderators.
  SHARED
  /// The mentor and moderators; never returned to the mentee.
  PRIVATE
}

model Note {
  id             String         @id @default(uuid()) @db.Uuid
  mentorshipId   String         @db.Uuid
  mentorship     Mentorship     @relation(fields: [mentorshipId], references: [id])
  authorId       String         @db.Uuid
  author         User           @relation("NoteAuthor", fields: [authorId], references: [id])
  /// The super admin who wrote this while impersonating the author (BR-ADM-5).
  impersonatorId String?        @db.Uuid
  impersonator   User?          @relation("NoteImpersonator", fields: [impersonatorId], references: [id])
  visibility     NoteVisibility
  body           String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([mentorshipId, createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ── Lookups (US-3.5, BR-ADM-2) ──────────────────────────────────────────
// Never hard-deleted: switch `active` off instead.

/// Where an activity type can be used. Group gathering types are the GROUP_RECURRING ones.
enum ActivityScope {
  INDIVIDUAL
  GROUP_RECURRING
  GROUP_ONE_OFF
}

/// The design's lookup palette (design/screens/ActivityTypes.dc.html).
enum LookupColor {
  PURPLE
  NAVY
  GREEN
  AMBER
  ROSE
  SLATE
}

enum ReminderLead {
  NONE
  H3
  H24
  H48
}

model ActivityType {
  id               String        @id @default(uuid()) @db.Uuid
  nameAr           String
  nameEn           String
  scope            ActivityScope
  color            LookupColor   @default(PURPLE)
  requiresRsvp     Boolean       @default(false)
  tracksAttendance Boolean       @default(false)
  showInFeed       Boolean       @default(true)
  reminder         ReminderLead  @default(NONE)
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  interactions Interaction[]
}

// ── Audit (BR-ADM-4, BR-MGR-8) ──────────────────────────────────────────

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @db.Uuid
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id])
  /// Whose account the actor was using: the impersonated user (BR-ADM-5), or in v2 the member a manager acted for.
  onBehalfOfId String?  @db.Uuid
  onBehalfOf   User?    @relation("AuditOnBehalfOf", fields: [onBehalfOfId], references: [id])
  action       String
  entity       String
  entityId     String
  diff         Json?
  createdAt    DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
}

/// Notes about a user for the people responsible for them: everyone above them in
/// the management chain, their current mentor, and moderators. Never shown to the user.
model AdminNote {
  id             String   @id @default(uuid()) @db.Uuid
  subjectId      String   @db.Uuid
  subject        User     @relation("AdminNoteSubject", fields: [subjectId], references: [id])
  authorId       String   @db.Uuid
  author         User     @relation("AdminNoteAuthor", fields: [authorId], references: [id])
  /// The super admin who wrote this while impersonating the author (BR-ADM-5).
  impersonatorId String?  @db.Uuid
  impersonator   User?    @relation("AdminNoteImpersonator", fields: [impersonatorId], references: [id])
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([subjectId, createdAt])
}

// ── Files and profile (US-2.1, US-2.2) ───────────────────────────────────

/**
 * An object in the S3 bucket (Railway Storage Buckets; SeaweedFS locally).
 */
model FileObject {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  mime      String
  size      Int
  createdAt DateTime @default(now())

  avatarOf User?
}

enum ContactKind {
  EMAIL
  PHONE
}

/**
 * A pending email or phone change, confirmed with an emailed code (US-2.2).
 */
model ContactChange {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id])
  kind      ContactKind
  value     String
  codeHash  String
  attempts  Int         @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([userId, kind, createdAt])
}

// ── Trackables (BR-TRK-1…6), challenges (BR-CHL-1…3) ─────────────────────

enum TrackableType {
  COUNT
  /// Done or not done: logged as 1 or 0.
  BOOLEAN
  /// 0 to 100.
  PERCENTAGE
}

enum TrackingCycle {
  DAILY
  WEEKLY
  MONTHLY
}

enum EntrySource {
  /// The mentee logged it.
  MENTEE
  /// Their mentor or an admin logged it, on its own or in a follow-up.
  MENTOR
}

/// Something a mentee tracks, measured once per cycle. Belongs to the mentee, so it survives a change of mentor.
model Trackable {
  id             String        @id @default(uuid()) @db.Uuid
  menteeId       String        @db.Uuid
  mentee         User          @relation("TrackableMentee", fields: [menteeId], references: [id])
  createdById    String        @db.Uuid
  createdBy      User          @relation("TrackableCreator", fields: [createdById], references: [id])
  /// The super admin who wrote this while impersonating the author (BR-ADM-5).
  impersonatorId String?       @db.Uuid
  impersonator   User?         @relation("TrackableImpersonator", fields: [impersonatorId], references: [id])
  /// The library template it follows (BR-TRK-7). Its name, goal, type, cycle
  /// and direction mirror the template's and change only through it.
  templateId     String?            @db.Uuid
  template       TrackableTemplate? @relation(fields: [templateId], references: [id])
  name           String
  goal           String?
  type           TrackableType
  cycle          TrackingCycle
  /// False for things that should go down (screen time, absences).
  higherIsBetter Boolean       @default(true)
  /// Per cycle; optional.
  target         Float?
  /// The first day tracking counts from (organisation calendar).
  startsOn       DateTime      @db.Date
  /// Weekly only: the day of the week (0 Sunday … 6 Saturday) its log shows on.
  /// Null shows it on the week's first day. The cycle is still the whole week.
  weekday        Int?          @db.SmallInt
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  entries TrackableEntry[]

  @@index([menteeId, archivedAt])
  @@index([templateId])
}

/// A reusable trackable in the library (BR-TRK-7…9). Mentees' trackables link
/// to it; editing it updates every linked trackable.
model TrackableTemplate {
  id             String        @id @default(uuid()) @db.Uuid
  authorId       String        @db.Uuid
  author         User          @relation("TemplateAuthor", fields: [authorId], references: [id])
  /// The super admin who wrote this while impersonating the author (BR-ADM-5).
  impersonatorId String?       @db.Uuid
  impersonator   User?         @relation("TemplateImpersonator", fields: [impersonatorId], references: [id])
  name           String
  goal           String?
  type           TrackableType
  cycle          TrackingCycle
  higherIsBetter Boolean       @default(true)
  /// Suggested target per cycle; each mentee's trackable keeps its own.
  target         Float?
  /// Offered to every mentor, not just the author.
  isPublic       Boolean       @default(false)
  /// Taken out of the library; linked trackables were detached.
  removedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  trackables Trackable[]

  @@index([authorId])
  @@index([isPublic])
}

/// One cycle's value. Logging the same cycle again replaces it.
model TrackableEntry {
  id             String       @id @default(uuid()) @db.Uuid
  trackableId    String       @db.Uuid
  trackable      Trackable    @relation(fields: [trackableId], references: [id])
  /// First day of the cycle (organisation calendar).
  periodStart    DateTime     @db.Date
  value          Float
  note           String?
  source         EntrySource
  /// The follow-up it was logged in, if any.
  interactionId  String?      @db.Uuid
  interaction    Interaction? @relation(fields: [interactionId], references: [id])
  authorId       String       @db.Uuid
  author         User         @relation("EntryAuthor", fields: [authorId], references: [id])
  /// The super admin who wrote this while impersonating the author (BR-ADM-5).
  impersonatorId String?      @db.Uuid
  impersonator   User?        @relation("EntryImpersonator", fields: [impersonatorId], references: [id])
  /// The mentee asked their mentor for help with this cycle.
  needsHelp      Boolean      @default(false)
  recordedAt     DateTime     @default(now())

  replies TrackableReply[]

  @@unique([trackableId, periodStart])
}

model TrackableReply {
  id             String         @id @default(uuid()) @db.Uuid
  entryId        String         @db.Uuid
  entry          TrackableEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  authorId       String         @db.Uuid
  author         User           @relation("ReplyAuthor", fields: [authorId], references: [id])
  /// The super admin who wrote this while impersonating the author (BR-ADM-5).
  impersonatorId String?        @db.Uuid
  impersonator   User?          @relation("ReplyImpersonator", fields: [impersonatorId], references: [id])
  body           String
  createdAt      DateTime       @default(now())

  @@index([entryId])
}

/// Something a mentee is struggling with, followed until resolved.
model Challenge {
  id             String       @id @default(uuid()) @db.Uuid
  menteeId       String       @db.Uuid
  mentee         User         @relation("ChallengeMentee", fields: [menteeId], references: [id])
  createdById    String       @db.Uuid
  createdBy      User         @relation("ChallengeCreator", fields: [createdById], references: [id])
  /// The super admin who wrote this while impersonating the author (BR-ADM-5).
  impersonatorId String?      @db.Uuid
  impersonator   User?        @relation("ChallengeImpersonator", fields: [impersonatorId], references: [id])
  /// The follow-up it was raised in, if any.
  interactionId  String?      @db.Uuid
  interaction    Interaction? @relation(fields: [interactionId], references: [id])
  title          String
  resolvedAt     DateTime?
  resolvedById   String?      @db.Uuid
  resolvedBy     User?        @relation("ChallengeResolver", fields: [resolvedById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  comments ChallengeComment[]

  @@index([menteeId, resolvedAt])
}

model ChallengeComment {
  id             String       @id @default(uuid()) @db.Uuid
  challengeId    String       @db.Uuid
  challenge      Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  authorId       String       @db.Uuid
  author         User         @relation("ChallengeCommentAuthor", fields: [authorId], references: [id])
  /// The super admin who wrote this while impersonating the author (BR-ADM-5).
  impersonatorId String?      @db.Uuid
  impersonator   User?        @relation("ChallengeCommentImpersonator", fields: [impersonatorId], references: [id])
  /// The follow-up it was written in, if any.
  interactionId  String?      @db.Uuid
  interaction    Interaction? @relation(fields: [interactionId], references: [id])
  body           String
  createdAt      DateTime     @default(now())

  @@index([challengeId, createdAt])
}
