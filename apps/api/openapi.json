  "info": {
    "title": "Tarbya API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "SignInRole": {
        "type": "string",
        "enum": [
          "MODERATOR",
          "MANAGER",
          "GROUP_ADMIN",
          "GROUP_MODERATOR",
          "MENTOR",
          "MENTEE"
        ]
      },
      "SettingsDto": {
        "type": "object",
        "properties": {
          "signInRoles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SignInRole"
            }
          },
          "contactDueDays": {
            "type": "number",
            "minimum": 1,
            "maximum": 90
          },
          "contactLateDays": {
            "type": "number",
            "minimum": 2,
            "maximum": 180
          },
          "rsvpRequestHours": {
            "type": "number",
            "minimum": 1,
            "maximum": 336
          },
          "reminderHours": {
            "type": "number",
            "minimum": 1,
            "maximum": 72
          },
          "trendWindow": {
            "type": "number",
            "minimum": 2,
            "maximum": 10
          },
          "trendSteadyBand": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.5
          }
        },
        "required": [
          "signInRoles",
          "contactDueDays",
          "contactLateDays",
          "rsvpRequestHours",
          "reminderHours",
          "trendWindow",
          "trendSteadyBand"
        ]
      },
      "UpdateSettingsDto": {
        "type": "object",
        "properties": {
          "signInRoles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SignInRole"
            }
          },
          "contactDueDays": {
            "type": "number",
            "minimum": 1,
            "maximum": 90
          },
          "contactLateDays": {
            "type": "number",
            "minimum": 2,
            "maximum": 180
          },
          "rsvpRequestHours": {
            "type": "number",
            "minimum": 1,
            "maximum": 336
          },
          "reminderHours": {
            "type": "number",
            "minimum": 1,
            "maximum": 72
          },
          "trendWindow": {
            "type": "number",
            "minimum": 2,
            "maximum": 10
          },
          "trendSteadyBand": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.5
          }
        }
      },
      "Locale": {
        "type": "string",
        "enum": [
          "ar",
          "en"
        ]
      },
      "CalendarPreference": {
        "type": "string",
        "enum": [
          "GREGORIAN",
          "HIJRI",
          "BOTH"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "SUPER_ADMIN",
          "MODERATOR",
          "MANAGER",
          "GROUP_ADMIN",
          "GROUP_MODERATOR",
          "MENTOR",
          "MENTEE"
        ]
      },
      "UserRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "locale": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Locale"
              }
            ]
          },
          "calendar": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CalendarPreference"
              }
            ]
          },
          "isModerator": {
            "type": "boolean"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          },
          "manager": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserRefDto"
              }
            ]
          },
          "deactivatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "canSignIn": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "locale",
          "calendar",
          "isModerator",
          "roles",
          "manager",
          "deactivatedAt",
          "canSignIn"
        ]
      },
      "UserPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "example": "+201001234567"
          },
          "locale": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Locale"
              }
            ]
          },
          "calendar": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CalendarPreference"
              }
            ]
          },
          "managerId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "locale": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Locale"
              }
            ]
          },
          "calendar": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CalendarPreference"
              }
            ]
          }
        }
      },
      "SetManagerDto": {
        "type": "object",
        "properties": {
          "managerId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "managerId"
        ]
      },
      "SetModeratorDto": {
        "type": "object",
        "properties": {
          "isModerator": {
            "type": "boolean"
          }
        },
        "required": [
          "isModerator"
        ]
      },
      "PasswordSignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "name@example.com"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "locale": {
            "allOf": [
              {
