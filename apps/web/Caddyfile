# Serves the SPA and proxies /api/* to the api over Railway's private network,
# so the auth cookies stay same-site.
{
	admin off
}

:{$PORT:8080} {
	# Not the event stream (BR-NTF-2): compressing it would hold events back.
	@compressible not path /api/events
	encode @compressible zstd gzip

	handle /api/* {
		reverse_proxy {$API_URL} {
			# Railway's edge sets X-Real-IP to the caller; the api trusts one proxy hop
			# and rate-limits sign-in per client IP.
			header_up X-Forwarded-For {http.request.header.X-Real-IP}
		}
	}

	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
