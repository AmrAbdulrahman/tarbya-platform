# Copy to .env for local development. Values match docker-compose.yml.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:4200
ORG_TIMEZONE=Africa/Cairo

DATABASE_URL=postgresql://tarbya:tarbya@localhost:5432/tarbya?schema=public

# Sign-in attempts per IP per minute. Production keeps the default of 10; dev and CI
# run several e2e suites against one API, so they need more.
AUTH_SIGN_IN_LIMIT_PER_MINUTE=100

# Long random string, at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-0123456789

# The single super admin (BR-USR-3)
SUPER_ADMIN_EMAIL=admin@tarbya.local
SUPER_ADMIN_NAME=Super admin
# Used only to set the first password on first boot
SUPER_ADMIN_PASSWORD=change-me-now

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Tarbya <no-reply@tarbya.local>"
# Production on Railway: set RESEND_API_KEY instead of the SMTP_* host settings, since
# Railway blocks outbound SMTP below the Pro plan. SMTP_FROM must be on a verified domain.
# RESEND_API_KEY=

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tarbya
S3_ACCESS_KEY_ID=tarbya
S3_SECRET_ACCESS_KEY=tarbya-secret
